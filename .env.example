# OpenRouter API key (preferred if you use OpenRouter)
OPENROUTER_API_KEY=

# Groq API key (if you use Groq)
GROQ_API_KEY=

# If using Groq, set the full URLs for chat & embeddings endpoints (Groq doesn't follow OpenAI shape by default)
GROQ_CHAT_URL=
GROQ_EMBEDDING_URL=

# Backwards-compatible OpenAI key (optional)
OPENAI_API_KEY=

# Redis URL, e.g. redis://localhost:6379
REDIS_URL=redis://localhost:6379

# SQLite DB path
SQLITE_DB=./data/embeddings.db

# Optional: system-wide default model
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
